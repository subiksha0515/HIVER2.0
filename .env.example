# AI Customer Support Agent - Environment Configuration
# Copy this file to .env and insert your API credentials if using live LLM endpoints.
# DO NOT COMMIT REAL API KEYS TO REPOSITORIES.

# LLM Provider Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Safety & Escalation Thresholds (Validated on val.jsonl)
MIN_INTENT_CONFIDENCE=0.45
MIN_RETRIEVAL_SIMILARITY=0.40
